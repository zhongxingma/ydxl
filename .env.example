# ========== ydxl 环境变量配置 ==========
# 本项目支持多 AI 供应商（deepseek / openai / qwen / custom）+ 本地服务器存储（Express + SQLite）
# AI 供应商的端点 / 模型 / 密钥变量名统一在 config/ai-providers.json 声明（单一注册表）；
# 本文件只配置实际密钥值与运行开关。密钥绝不写入 config/ai-providers.json（该文件可进版本库）。
# 部署方式：Linux 服务器本地部署，详见 docs/LINUX_DEPLOY.md

# ---------- 前端环境变量（Vite 注入，打包进 bundle） ----------

# AI 供应商选择（可选值：deepseek / openai / qwen / custom，默认 deepseek）
# 优先级：用户在"个人中心"的选择（localStorage）> 此环境变量 > 自动检测（custom env 配置完整时选 custom）> deepseek
# ⚠️ 使用自定义模型（VITE_CUSTOM_* 配置）时必须将此值改为 custom，否则请求仍路由到内置供应商
VITE_AI_PROVIDER=deepseek

# DeepSeek AI 配置
VITE_DEEPSEEK_API_KEY=
# 模型名：deepseek-v4-pro（高质量）或 deepseek-v4-flash（轻量）
# 官方定价（https://api-docs.deepseek.com/zh-cn/quick_start/pricing，单位：元/百万 tokens）：
#   deepseek-v4-pro:  输入缓存命中 0.025 / 缓存未命中 3 / 输出 6
#   deepseek-v4-flash: 输入缓存命中 0.02 / 缓存未命中 1 / 输出 2
# 注意：deepseek-chat 与 deepseek-reasoner 已于 2026/07/24 23:59 官方停用，请使用 deepseek-v4-pro / deepseek-v4-flash
# Thinking 模式默认启用（reasoning_content 按输出 token 计费）
# 可通过 thinkingDisabled 禁用思考（机械性任务），或用 reasoning_effort: 'high'|'max' 控制思考强度
VITE_DEEPSEEK_MODEL=deepseek-v4-pro

# OpenAI 配置（前端直连时使用；走代理模式则仅服务端需要 OPENAI_API_KEY）
VITE_OPENAI_API_KEY=
# 模型名：gpt-5.2（高质量）或 gpt-5.2-mini（轻量）；留空使用内置默认 gpt-5.2
VITE_OPENAI_MODEL=

# 通义千问配置（DashScope compatible-mode，OpenAI 兼容协议）
# API Key 从阿里云百炼控制台获取：https://bailian.console.aliyun.com/?apiKey=1
VITE_QWEN_API_KEY=
# 模型名：qwen3-max（高质量）或 qwen3-turbo（轻量）；留空使用内置默认 qwen3-max
VITE_QWEN_MODEL=

# 自定义模型配置（OpenAI Chat Completions 兼容端点，参考 Trae IDE 自定义模型设计）
# ── 优先级：个人中心配置（localStorage）> 本文件默认值 ───────────────────────────
# 请求地址支持两种格式（自动处理，无需手动拼接后缀）：
#   Base URL:    https://openrouter.ai/api/v1        → 自动拼接 /chat/completions
#   完整 URL:    https://api.example.com/v1/chat/completions → 原样使用
# 常见服务示例：
#   OpenRouter:      https://openrouter.ai/api/v1
#   本地 Ollama:     http://localhost:11434/v1
#   Groq:            https://api.groq.com/openai/v1
#   硅基流动 SiliconFlow: https://api.siliconflow.cn/v1
# 路由模式说明：
#   1) 生产代理模式（VITE_AI_PROXY_URL 已配置）且用户未在个人中心自填端点时，
#      请求走服务端 /v1/ai-proxy/custom 节点（规避浏览器直连第三方 API 的 CORS
#      限制，上游密钥由服务端 CUSTOM_API_KEY 持有，不进前端 bundle）。
#      需同时在服务端配置 CUSTOM_API_ENDPOINT / CUSTOM_API_KEY（见下方服务端段落）。
#   2) 用户在「个人中心 → AI 设置」填写了自己的请求地址时保持浏览器直连
#      （用户端点不经服务端转发，避免 SSRF 风险；需第三方 API 支持 CORS）
#   3) 开发环境（无 VITE_AI_PROXY_URL）走浏览器直连
# 端点与模型 ID 统一由 config/ai-providers.json 声明（vite 构建注入 VITE_CUSTOM_API_ENDPOINT / VITE_CUSTOM_MODEL，
# 服务端读取同一 JSON 派生 CUSTOM_API_ENDPOINT / CUSTOM_MODELS），无需在此重复配置。
# 默认 API Key（可选）：仅当用户未在个人中心填写 Key 时作为兜底。
# ⚠️ 构建时会打进前端产物（公开可见），切勿填入生产密钥！生产环境请让每位用户
#    在个人中心自行填写（经 secureStorage 加密存储在本地浏览器）
VITE_CUSTOM_API_KEY=

# 本地服务器 API 基础路径（开发环境通过 vite proxy 转发到 http://localhost:3001）
VITE_API_BASE_URL=/api

# AI 代理地址
# 注意：前端 Provider 会自动拼接 /v1/ai-proxy/<provider> 后缀（见 baseProvider.ts 的 resolveEndpoint），
# 故此处填 API 基础路径即可，不要填完整代理路径，否则会产生 /api/v1/ai-proxy/v1/ai-proxy/deepseek 这样的重复路径。
# 本地开发设置为 /api，经 vite proxy 转发到 http://localhost:3001，最终请求路径为 /api/v1/ai-proxy/<provider>；
# API key 保留在服务端对应供应商的 *_API_KEY，前端无需直连 key。
# 生产环境同理配置实际 API 基础路径；留空则走前端直连（需配置对应供应商的 VITE_*_API_KEY）
VITE_AI_PROXY_URL=/api
VITE_AI_PROXY_TOKEN=

# ---------- 服务端环境变量（仅 Linux 服务器，不打包进 bundle） ----------

# DeepSeek API Key（服务端 AI 代理使用，从 https://platform.deepseek.com/api_keys 获取）
# 重要：前端走代理模式（VITE_AI_PROXY_URL=/api，默认配置）时，所有 AI 请求经服务端转发，
#       必须在此填写真实 API Key。留空会导致 ai-proxy.ts 返回 503 PROXY_NOT_CONFIGURED，
#       表现为"练习题生成失败"、"生词 AI 补全失败"等功能性故障（多轮代码修复均无法解决）。
# 开发环境可直接复用 VITE_DEEPSEEK_API_KEY 的值；生产环境建议服务端独立配置，不打包进前端 bundle
DEEPSEEK_API_KEY=

# OpenAI API Key（服务端 AI 代理使用；仅在选用 openai 供应商时必须配置，否则该路由返回 503）
OPENAI_API_KEY=

# 通义千问 API Key（服务端 AI 代理使用；仅在选用 qwen 供应商时必须配置，否则该路由返回 503）
QWEN_API_KEY=

# 自定义模型上游端点与模型白名单统一由 config/ai-providers.json 声明
# （server/src/index.ts 启动时读取同一 JSON 派生 CUSTOM_API_ENDPOINT / CUSTOM_MODELS）。
# 建议在该 JSON 中维护以下内容：
#   { "custom": { "endpoint": "https://api.siliconflow.cn/v1", "model": "deepseek-ai/DeepSeek-V4-Flash" } }
# 配置后前端 custom 请求走服务端 /v1/ai-proxy/custom 转发到此端点：
#   - 规避浏览器直连第三方 API 的 CORS 限制（直连在生产环境大概率失败并兜底到 DeepSeek）
#   - 密钥留在服务端，不进前端 bundle
# 未配置时该路由返回 503，前端自动回退 DeepSeek 兜底。
# 自定义模型上游 API Key（仅服务端持有，安全）
CUSTOM_API_KEY=

# AI 代理鉴权 token（如启用代理鉴权，需与前端 VITE_AI_PROXY_TOKEN 一致）
# 注意：当前服务端 ai-proxy.ts 尚未实现代理鉴权校验，此变量为预留项，待后续启用
AI_PROXY_TOKEN=

# Node 运行环境（production / development / test，默认 development）
# - production：启用安全默认（CORS 仅本机、错误信息脱敏、加密强制配置 ENCRYPTION_KEY 否则拒绝启动）
# - development：开发友好（CORS 允许所有、错误暴露原始消息、加密禁用明文存储）
# - test：测试环境（使用内存数据库 :memory:，禁用加密，由 __tests__/setup.ts 注入）
# 影响位置：index.ts（CORS/错误处理）、encryption.ts（加密开关）、db.ts（数据库选择）、routes.ts（日志）
NODE_ENV=development

# 本地服务器端口（默认 3001）
PORT=3001

# CORS 允许来源白名单（逗号分隔）
# - 未配置时：生产环境默认仅允许本机（http://localhost, http://127.0.0.1），开发环境允许所有来源
# - 生产环境必须配置为实际前端域名白名单，示例：CORS_ORIGIN=https://ydxl.example.com,https://www.ydxl.example.com
CORS_ORIGIN=

# ---------- 多用户认证（P0） ----------
# 首次启动多用户迁移时创建的管理员账号（仅 users 表为空时生效，迁移后修改无效）
# ADMIN_USERNAME：管理员登录名（默认 admin）
ADMIN_USERNAME=admin
# ADMIN_INITIAL_PASSWORD：管理员初始密码（至少 6 位）
# 留空时自动生成随机密码并打印到服务端控制台一次，请尽快登录后修改
# 生产环境建议显式配置强密码
ADMIN_INITIAL_PASSWORD=

# 数据加密密钥（用于 SQLite 敏感字段加密存储，如 words.note 用户笔记）
# - 推荐：32 字节 hex 字符串（64 个十六进制字符），可用 `openssl rand -hex 32` 生成
# - 兼容：任意长度 passphrase（通过 SHA-256 派生 32 字节密钥）
# - 未配置时：
#   * 生产环境：fail-fast 拒绝启动（强制配置，避免重启后无法解密旧数据的数据可用性风险）
#   * 开发/测试环境：禁用加密，明文存储（保持测试兼容）
# 警告：配置后切勿修改，否则已加密的数据将无法解密
ENCRYPTION_KEY=

# SQLite 数据库文件路径（可选，默认 server/data/ydxl.db）
# - 留空（推荐）：按 NODE_ENV 自动选择
#     * NODE_ENV=test → :memory:（内存数据库，避免清空生产数据）
#     * 其他 → server/data/ydxl.db（运行时自动创建 data/ 目录）
# - 设为 :memory:：强制使用内存数据库（仅测试用）
# - 自定义路径：相对路径基于 process.cwd() 解析（即 server/ 启动目录）
DB_PATH=
