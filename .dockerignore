# 构建上下文排除项（镜像构建只需要源码、配置与 lockfile）
node_modules
server/node_modules

# 本地构建产物与缓存
dist
server/dist
coverage
*.tsbuildinfo

# 测试与本地运行数据
e2e
test-results
playwright-report
blob-report
.e2e-tmp
server/data

# 环境变量（含真实密钥，运行时通过 env_file / -e 注入，禁止进镜像）
.env
.env.*
!.env.example

# 文档与仓库元数据
docs
.github
.husky
.vscode
.git
*.log
